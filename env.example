# VyceAI API — https://vyceai.com/v1/chat/completions
# Get your key from VyceAI dashboard and set it here
VYCEAI_API_KEY=sk-...
# Legacy alias — also accepted
NEW_API_KEY=sk-...

# Legacy fallbacks (optional)
# SEEKAI_API_KEY=sk-...
# TABITOKEN_API_KEY=sk-...
# TOKENROUTER_API_KEY=sk-...
# ORCAROUTER_API_KEY=sk-...

# Example curl (already configured in lib/ai.js):
# curl https://vyceai.com/v1/chat/completions \
#   -H "Content-Type: application/json" \
#   -H "Authorization: Bearer $VYCEAI_API_KEY" \
#   -d '{\"model\":\"gpt-5.6-luna\",\"messages\":[{\"role\":\"user\",\"content\":\"Explain quantum entanglement in one paragraph.\"}],\"temperature\":0.7}'
